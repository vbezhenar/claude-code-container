run \
  --mount=type=cache,id=trixie-apt-cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,id=trixie-apt-lists,target=/var/lib/apt/lists,sharing=locked \
  <<'eof'
# install claude-code
