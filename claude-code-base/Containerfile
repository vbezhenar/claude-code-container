from docker.io/library/debian:trixie

run \
  --mount=type=cache,id=trixie-apt-cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,id=trixie-apt-lists,target=/var/lib/apt/lists,sharing=locked \
  <<'eof'
# install base packages
set -o errexit

rm '/etc/apt/apt.conf.d/docker-clean'

apt-get update

DEBIAN_FRONTEND=noninteractive \
apt-get --no-install-recommends --assume-yes install \
  'bind9-dnsutils' \
  'build-essential' \
  'ca-certificates' \
  'curl' \
  'file' \
  'git' \
  'iproute2' \
  'jq' \
  'openssh-client' \
  'pkgconf' \
  'poppler-utils' \
  'procps' \
  'psmisc' \
  'python3-dev' \
  'python3-pip' \
  'python3-venv' \
  'ripgrep' \
  'rsync' \
  'shellcheck' \
  'sqlite3' \
  'strace' \
  'sudo' \
  'tree' \
  'unzip' \
  'xxd' \
  'xz-utils' \
  'zip'

eof

copy --chmod=644 'rootfs/etc/apt/keyrings/claude-code.asc' '/etc/apt/keyrings/'

copy --chmod=644 'rootfs/etc/apt/sources.list.d/claude-code.sources' '/etc/apt/sources.list.d/'

run \
  --mount=type=cache,id=trixie-apt-cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,id=trixie-apt-lists,target=/var/lib/apt/lists,sharing=locked \
  <<'eof'
# install claude-code
set -o errexit

apt-get update

DEBIAN_FRONTEND=noninteractive \
apt-get --no-install-recommends --assume-yes install \
  'claude-code'

eof

run \
  --mount=type=cache,id=trixie-apt-cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,id=trixie-apt-lists,target=/var/lib/apt/lists,sharing=locked \
  --mount=type=cache,id=claude-code-downloads,target=/tmp/downloads,sharing=locked \
  <<'eof'
# install hurl
set -o errexit
set -o nounset

v='8.1.0'
f="hurl_${v}_amd64.deb"
u="https://github.com/Orange-OpenSource/hurl/releases/download/${v}/${f}"

if [ ! -e "/tmp/downloads/hurl/${f}" ]; then
  mkdir --parents '/tmp/downloads/hurl'
  curl --fail --location --show-error --silent \
    --output "/tmp/downloads/hurl/_${f}" "${u}"
  mv "/tmp/downloads/hurl/_${f}" "/tmp/downloads/hurl/${f}"
fi

apt-get update

DEBIAN_FRONTEND=noninteractive \
apt-get --no-install-recommends --assume-yes install \
  "/tmp/downloads/hurl/${f}"

eof

copy --chmod=644 'rootfs/etc/claude-code/CLAUDE.md' '/etc/claude-code/'

copy --chmod=644 'rootfs/etc/claude-code/managed-settings.json' '/etc/claude-code/'

copy --chmod=440 'rootfs/etc/sudoers.d/claude' '/etc/sudoers.d/'

run <<'eof'
# configure environment
set -o errexit

groupadd --gid=1000 'claude'

useradd --create-home --gid=1000 --shell='/bin/bash' --uid=1000 'claude'

install --group=1000 --mode=700 --owner=1000 --directory \
  '/home/claude/.claude' \
  '/home/claude/.config'

eof

env CLAUDE_CONFIG_DIR='/home/claude/.claude'

env LANG='C.utf8'

entrypoint [ "claude" ]
