from localhost/claude-code-base:latest

copy --chmod=644 'rootfs/etc/apt/keyrings/adoptium.asc' '/etc/apt/keyrings/'

copy --chmod=644 'rootfs/etc/apt/sources.list.d/adoptium.sources' '/etc/apt/sources.list.d/'

run \
  --mount=type=cache,id=trixie-apt-cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,id=trixie-apt-lists,target=/var/lib/apt/lists,sharing=locked \
  <<'eof'
# install java dependencies
set -o errexit
set -o nounset

apt-get update

dependencies=$(apt-cache show --no-all-versions 'temurin-21-jdk' | sed -n 's/^Depends: //p')
DEBIAN_FRONTEND=noninteractive \
apt-get --no-install-recommends --assume-yes satisfy \
  "${dependencies}"

eof

run \
  --mount=type=cache,id=maven-cache,target=/tmp/maven-cache,sharing=locked \
  <<'eof'
# install maven
set -o errexit
set -o nounset

v='3.10.2'
f="apache-maven-${v}-bin.tar.gz"
u="https://dlcdn.apache.org/maven/maven-3/${v}/binaries/${f}"

if [ -e "/tmp/maven-cache/${f}" ]; then
  curl --fail --head --location --show-error --silent \
    --output '/dev/null' "${u}"
else
  curl --fail --location --show-error --silent \
    --output "/tmp/maven-cache/_${f}" "${u}"
  mv "/tmp/maven-cache/_${f}" "/tmp/maven-cache/${f}"
fi

mkdir '/opt/apache-maven-3'

tar --extract \
  --file="/tmp/maven-cache/${f}" \
  --no-same-owner --no-same-permissions --gzip \
  --strip-components=1 \
  --directory='/opt/apache-maven-3'

ln --symbolic '/opt/apache-maven-3/bin/mvn' '/usr/local/bin/mvn'

eof

run <<'eof'
# create ~/.gradle and ~/.m2
set -o errexit

install --group=1000 --mode=700 --owner=1000 --directory \
  '/home/claude/.gradle' \
  '/home/claude/.m2'

eof
